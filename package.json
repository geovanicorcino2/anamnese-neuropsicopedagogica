{
  "name": "anamnese-neuropsicopedagogica",
  "version": "0.2.0",
  "description": "App desktop (Windows) para preenchimento e exportação da ficha de anamnese neuropsicopedagógica de Ana Paula M. Gontijo.",
  "main": "./out/main/index.js",
  "author": "Corcino Consultoria",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "validar-schema": "tsx --tsconfig tsconfig.node.json scripts/validarAnamneseSchema.ts",
    "gerar-identidade-visual": "node scripts/gerarIdentidadeVisual.js",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "br.com.corcinoconsultoria.anamnese",
    "productName": "Anamnese Neuropsicopedagógica",
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/**/*.{md,map,ts}",
      "!node_modules/.bin"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
